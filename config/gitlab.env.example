# GitLab API & Package Registry Configuration
# Copy this file to config/gitlab.env and fill in your values.
# IMPORTANT: config/gitlab.env contains sensitive credentials and is gitignored.

# GitLab Instance URL (default: https://gitlab.com)
GITLAB_URL="https://gitlab.com"

# GitLab Project ID (Numeric ID found on your project's main page right below the project title)
GITLAB_PROJECT_ID="12345678"

# GitLab Personal Access Token or Project Access Token
# Required token scope: "api" (or "write_package_registry")
GITLAB_TOKEN="glpat-xxxxxxxxxxxxxxxxxxxx"

# Package Name in Generic Package Registry (optional, defaults to "taskbar")
GITLAB_PACKAGE_NAME="taskbar"
