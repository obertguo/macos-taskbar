# Build and Packaging Configuration
# Used by scripts/build-app.sh and scripts/generate-config.sh

APP_NAME="Taskbar"
BUNDLE_ID="com.local.taskbar"
APP_VERSION="0.2.0"
BUILD_NUMBER="3"
MIN_MACOS_VERSION="14.0"
INSTALL_DIR="~/Applications"

# Code Signing Identity:
# If left empty or set to "auto", scripts/build-app.sh will:
# 1. Search for an "Apple Development" certificate
# 2. Fall back to any valid codesigning identity
# 3. Fall back to ad-hoc signing ("-")
SIGN_IDENTITY="auto"

# Test Harness & Benchmark Thresholds (used by scripts/test-functional.sh)
TEST_MAX_RSS_MB="45.0"
TEST_MAX_CPU_PERCENT="2.0"
TEST_AX_AUTH_TIMEOUT_SECONDS="15"
TEST_FIXTURE_APP="TextEdit"

